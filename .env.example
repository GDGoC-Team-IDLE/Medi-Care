# .env.example
# DB (Neon) - 개발은 dev 브랜치 주소, 배포는 main 브랜치 주소
DATABASE_URL=
TZ=Asia/Seoul
CORS_ORIGINS=http://localhost:8081

# 인증 사진 (Supabase Storage) - SERVICE_ROLE_KEY는 서버 전용, 앱에 절대 넣지 말 것
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=dose-photos

# 기능별 (담당자가 채움)
GEMINI_API_KEY=
MFDS_SERVICE_KEY=
JWT_SECRET=
EXPO_ACCESS_TOKEN=
INTERNAL_TOKEN=
CRON_SECRET=
MISSED_AFTER_MINUTES=60
MEDICATION_LOW_DAYS=3
